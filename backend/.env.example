# ─────────────────────────────────────────────────────────────
# Convoy backend — copy this file to `config.env` and fill in.
# config.env is gitignored and must never be committed.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── MongoDB ──────────────────────────────────────────────────
# DATABASE may contain the literal <db_password> token; it is replaced
# at startup with DATABASE_PASSWORD. (Or just inline the full URI and
# leave DATABASE_PASSWORD blank.)
DATABASE=mongodb+srv://<user>:<db_password>@cluster0.example.mongodb.net/authstarter?retryWrites=true&w=majority
DATABASE_PASSWORD=your_db_password

# ── JSON Web Token ───────────────────────────────────────────
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRESIN=90d
JWT_COOKIE_EXPIRES_IN=90

# ── OTP ──────────────────────────────────────────────────────
OTP_EXPIRES_IN_MIN=10

# ── Gmail transactional email (Nodemailer) ───────────────────
# Use a Google App Password: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
MAIL_FROM_NAME=Auth Starter

# ── Google Sign-In ───────────────────────────────────────────
# The single switch: true  → enable Google Identity Services sign-in
#                    false → email/phone + password only (Google hidden)
GOOGLE_AUTH_ENABLED=false
# Required only when GOOGLE_AUTH_ENABLED=true. Get it from:
# https://console.cloud.google.com/apis/credentials  (OAuth 2.0 Client ID,
# type "Web application"). Add your frontend origin to Authorized JS origins.
GOOGLE_CLIENT_ID=

# ── Redis (live vehicle positions) ───────────────────────────
# Live positions are written here on every ping and NEVER to Mongo.
# Local install or a free-tier Upstash/Redis Cloud URL both work.
REDIS_URL=redis://127.0.0.1:6379
REDIS_LIVE_TTL_SEC=21600

# ── Trips ────────────────────────────────────────────────────
TRIP_CODE_LENGTH=6
TRIP_JOIN_TOKEN_EXPIRES_IN_HOURS=24
# Backstop against a forgotten trip broadcasting location for days.
TRIP_ABANDON_AFTER_HOURS=12
TRIP_MAX_VEHICLES=25

# ── Location / staleness / downsampling ──────────────────────
# The Android client mirrors these two so both ends agree on "live".
LOCATION_STALE_AFTER_SEC=30
LOCATION_LOST_AFTER_SEC=180
# A ping is written to Track history only when it clears one of these.
LOCATION_HISTORY_MIN_DISTANCE_M=50
LOCATION_HISTORY_MIN_INTERVAL_SEC=30
LOCATION_HISTORY_MIN_HEADING_DELTA_DEG=30
TRACK_BUCKET_MAX_POINTS=120
TRACK_BUCKET_MAX_MINUTES=10
TRACK_RETENTION_DAYS=90
