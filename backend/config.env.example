# ─────────────────────────────────────────────────────────────
# LOCAL DEVELOPMENT ONLY — gitignored, never committed.
# Generated for local testing against the MongoDB already running
# on 127.0.0.1:27017. Replace every value before any deployment.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# ── MongoDB (local) ──────────────────────────────────────────
DATABASE=
DATABASE_PASSWORD=

# ── JSON Web Token ───────────────────────────────────────────
# Dev-only secret. MUST be regenerated for staging/production.
JWT_SECRET=
JWT_EXPIRESIN=90d
JWT_COOKIE_EXPIRES_IN=90

# ── OTP ──────────────────────────────────────────────────────
OTP_EXPIRES_IN_MIN=10

# ── Gmail transactional email (Nodemailer) ───────────────────
# Unused by device auth. Only needed if the local email/password
# signup flow is exercised.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Convoy

# ── Google Sign-In ───────────────────────────────────────────
GOOGLE_AUTH_ENABLED=
GOOGLE_CLIENT_ID=

# ── Redis (live vehicle positions) ───────────────────────────
REDIS_URL=redis://127.0.0.1:6379
REDIS_LIVE_TTL_SEC=

# ── Trips ────────────────────────────────────────────────────
TRIP_CODE_LENGTH=6
TRIP_JOIN_TOKEN_EXPIRES_IN_HOURS=24
TRIP_ABANDON_AFTER_HOURS=12
TRIP_MAX_VEHICLES=25

# ── Location / staleness / downsampling ──────────────────────
LOCATION_STALE_AFTER_SEC=30
LOCATION_LOST_AFTER_SEC=180
LOCATION_HISTORY_MIN_DISTANCE_M=50
LOCATION_HISTORY_MIN_INTERVAL_SEC=30
LOCATION_HISTORY_MIN_HEADING_DELTA_DEG=30
TRACK_BUCKET_MAX_POINTS=120
TRACK_BUCKET_MAX_MINUTES=10
TRACK_RETENTION_DAYS=90

# ── Routing ──────────────────────────────────────────────────────
# Google Maps Platform DEMO key. Development only: Google states it is
# "intended for testing and prototyping purposes only, and is not designed
# for production use", under its own separate Terms of Service. It needs no
# billing account and has a per-API DAILY limit that pauses rather than
# charges — so the worst case is a fallback, never a bill.
# Leave blank to run entirely on OSRM.
GOOGLE_ROUTES_KEY=
GOOGLE_ROUTES_ENABLED=true
# Our own conservative ceiling, well under whatever Google's undisclosed
# daily limit is. Counted per UTC day and reset automatically.
GOOGLE_ROUTES_DAILY_BUDGET=200
OSRM_URL=https://router.project-osrm.org
