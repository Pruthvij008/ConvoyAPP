//- Shared shell for all transactional emails. Table-based markup keeps it
//- rendering consistently across email clients.
doctype html
html
  head
    meta(charset="utf-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
  body(style="margin:0;padding:0;background:#f4f5f7;font-family:Arial,Helvetica,sans-serif;")
    table(role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f4f5f7;padding:32px 0;")
      tr
        td(align="center")
          table(role="presentation" width="480" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb;")
            tr
              td(style="background:#111827;padding:20px 32px;")
                span(style="color:#ffffff;font-size:18px;font-weight:bold;letter-spacing:.3px;")= subject
            tr
              td(style="padding:32px;color:#374151;font-size:15px;line-height:1.6;")
                block content
            tr
              td(style="padding:20px 32px;background:#f9fafb;color:#9ca3af;font-size:12px;border-top:1px solid #e5e7eb;")
                | You received this email because an action was requested with your address. If it wasn't you, you can safely ignore it.
