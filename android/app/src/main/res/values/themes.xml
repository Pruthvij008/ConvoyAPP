<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose paints everything; this only covers the window before the
         first frame. Dark, so a night launch does not flash white. -->
    <style name="Theme.Convoy" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night_ground</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
